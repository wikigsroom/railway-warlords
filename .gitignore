# Native engine imports and local binaries; import settings (*.import) stay tracked.
/.godot/
/build/
/--script
__pycache__/
*.py[cod]
*.tmp
*.log
*.err
Thumbs.db
.DS_Store

# Credentials and machine-local configuration.
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pfx
*.pem
.export_credentials
.godot/export_credentials.cfg
/.toolchain/
/signing/

