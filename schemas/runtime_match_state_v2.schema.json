{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Railway Warlords runtime match state v2",
  "type": "object",
  "required": [
    "schema_version",
    "ruleset_version",
    "content_hash",
    "scenario_id",
    "mode",
    "date",
    "round",
    "phase_index",
    "state_version",
    "turn_order",
    "status",
    "map",
    "units",
    "cities",
    "factions",
    "generals",
    "objectives",
    "visibility",
    "relations",
    "metrics",
    "combat_random"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "ruleset_version": {
      "const": 9
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "campaign",
        "conquest",
        "legion"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "phase_index": {
      "type": "integer",
      "minimum": 0
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "playing",
        "won",
        "lost"
      ]
    },
    "turn_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "map": {
      "type": "object",
      "required": [
        "id",
        "cells",
        "cities",
        "rail_edges",
        "rail_nodes",
        "crossings"
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "def_id",
          "owner_id",
          "position",
          "hp",
          "max_hp",
          "ap_left",
          "ammo",
          "supply_state",
          "cargo_parent_id",
          "experience"
        ],
        "properties": {
          "position": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/hex"
              }
            ]
          },
          "hp": {
            "type": "integer",
            "minimum": 1
          },
          "max_hp": {
            "type": "integer",
            "minimum": 1
          },
          "ap_left": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "ammo": {
            "type": "integer",
            "minimum": 0
          },
          "supply_state": {
            "enum": [
              "FULL",
              "LOW",
              "NONE"
            ]
          },
          "experience": {
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          }
        }
      }
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner_id",
          "position",
          "fort_hp",
          "buildings",
          "recruit_queue",
          "construction_queue"
        ],
        "properties": {
          "position": {
            "$ref": "#/$defs/hex"
          },
          "fort_hp": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "resources",
          "profile_snapshot",
          "equipment_whitelist",
          "eliminated"
        ],
        "properties": {
          "resources": {
            "type": "object",
            "required": [
              "cash",
              "food",
              "arms"
            ],
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "generals": {
      "type": "array"
    },
    "objectives": {
      "type": "array"
    },
    "visibility": {
      "type": "array"
    },
    "relations": {
      "type": "array"
    },
    "metrics": {
      "type": "object"
    },
    "combat_random": {
      "type": "object",
      "required": [
        "algorithm",
        "state",
        "draws"
      ],
      "properties": {
        "algorithm": {
          "const": "park_miller_48271_v1"
        },
        "state": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "draws": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "object",
      "required": [
        "q",
        "r"
      ],
      "properties": {
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
